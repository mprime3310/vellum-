{
  "name": "vellum-cv-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Vellum — an AI-powered CV generator with a professional A4 pagination engine and PDF/DOCX export.",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node dist/server/server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "rolldown scripts/verify.ts -d scripts/.out --format esm --platform node && node scripts/.out/verify.js",
    "probe": "node scripts/run-layout-probe.mjs",
    "probe:stress": "node scripts/run-layout-probe.mjs --stress",
    "live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.55",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "ai": "^7.0.114",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "srvx": "^0.11.22",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
