# Server-side key for the default AI provider ("Vellum AI" / AI Gateway).
# Optional: visitors can instead bring their own key (Groq / Gemini / OpenAI / DeepSeek)
# from the "AI Settings" dialog in the app. Keys are stored only in their browser.
LOVABLE_API_KEY=

# Optional overrides for the default gateway.
# AI_GATEWAY_BASE_URL=https://ai.gateway.lovable.dev/v1
# AI_GATEWAY_MODEL=google/gemini-2.5-flash
